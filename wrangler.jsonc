{
  // wrangler.jsonc — единственный конфиг Wrangler (wrangler.toml удалён ранее).
  "$schema": "node_modules/wrangler/config-schema.json",

  // ⚠️ Имя воркера: должно совпадать с существующим воркером Cloudflare.
  // НЕ менять — иначе создастся ДРУГОЙ воркер без KV, секретов и домена.
  "name": "nuxt-shop",

  "main": ".output/server/index.mjs",
  // Согласовано с compatibilityDate в nuxt.config.ts
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Клиентский API-базовый URL (runtimeConfig.public.apiBaseUrl).
    // Пусто → useApi ходит на /api/** того же origin. Если задать URL
    // внешнего API: useApi переключится на него СРАЗУ (runtimeConfig
    // читается на рантайме), а preconnect в <head> появится после
    // ПЕРЕСБОРКИ (он вшивается в prerender/<head> при билде).
    // См. nuxt.config.ts → app.head.link.
    "NUXT_PUBLIC_API_BASE_URL": "",
  },
  "kv_namespaces": [
    {
      // ⚠️ Биндинг обязан называться "KV" — его читают server/lib/storage.ts
      // (каталог data:products) и server/lib/imageStorage.js (картинки img:*)
      "binding": "KV",
      // ⚙️ НАСТРОЙКА: ID вашего KV namespace
      "id": "2882e3a4601940b881c2140f1401989f",
      // Удалённое KV при wrangler dev
      "remote": true,
    },
  ],
  // Картинки из админки: Workers KV (namespace выше) под префиксом "img:",
  // вместо base64 в JSON (server/lib/imageStorage.js). Раздача:
  // server/routes/api/images/[...key].ts → /api/images/<key>.
  // Лимиты free-тарифа KV: 1 ГБ хранения, 1000 записей/день, 100k чтений/день —
  // для картинок товара (десятки–сотни КБ, раздаются с immutable-кэшем)
  // хватает с большим запасом.
  // R2 НЕ используется: включение R2 требует платёжной карты в Cloudflare.
  // Если когда-нибудь включите R2 — верните блок r2_buckets с биндингом
  // IMAGES_BUCKET, код записи/выдачи начнёт использовать его автоматически.
  // Telegram-секреты (TELEGRAM_BOT_TOKEN, TELEGRAM_ADMIN_CHAT_ID,
  // TELEGRAM_WEBHOOK_SECRET, TELEGRAM_ADMIN_USER_IDS) ЗДЕСЬ НЕ ОБЪЯВЛЯЮТСЯ:
  // схемы не существует, секреты управляются через
  // `npx wrangler secret put` / дашборд и переживают деплой сами.
}
