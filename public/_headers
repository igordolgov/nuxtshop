# public/_headers — HTTP-заголовки для статических файлов.
#
# Файл копируется nitro в .output/public и применяется Cloudflare
# Workers Static Assets при деплое (см. assets.directory в wrangler.jsonc).
# Действует ТОЛЬКО на статику (файлы из assets); SSR-ответы рендерит
# воркер — их этот файл не касается.
#
# ПОРЯДОК ПРАВИЛ ВАЖЕН: при совпадении нескольких блоков для одного пути
# одноимённый заголовок перебирает ПОСЛЕДНЕЕ правило — от общих паттернов
# идём к специфичным.

# ── Service worker: ВСЕГДА из сети ─────────────────────────────────
# Иначе браузер закэширует sw.js на год, и автообновление PWA
# (autoUpdate) застрянет: пользователи будут жить на старой версии.

/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache

# ── Общий кэш картинок сайта: сутки ────────────────────────────────
# Только конкретные служебные файлы. ⚠️ Не использовать широкое правило
# /images/*: оно пересекается с /images/products/*, и Cloudflare склеивает
# одноимённые заголовки в один (проверено в wrangler dev): "public,
# max-age=86400, public, max-age=31536000, immutable". Дубликаты директив
# Cache-Control браузеры и CDN трактуют по-разному — надёжнее не допускать.

/images/placeholder.jpg
  Cache-Control: public, max-age=86400
/images/no-image.svg
  Cache-Control: public, max-age=86400

# ── Товарные фото: год, immutable ──────────────────────────────────
# Имена уникальны и содержат timestamp (product-*-<ts>.webp) — новая
# версия картинки = новое имя файла, старый URL менять не будет.
# Специфичное правило ниже перекрывает /images/*.

/images/products/*
  Cache-Control: public, max-age=31536000, immutable

# ── Бандлы Vite: год, immutable ────────────────────────────────────
# Имена хэшированные (/_nuxt/entry.<hash>.js) — смена контента меняет имя.

/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# ── Иконки и манифест: умеренный TTL ───────────────────────────────

/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/pwa-192x192.png
  Cache-Control: public, max-age=86400
/pwa-512x512.png
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=3600
