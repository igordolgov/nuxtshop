{
  "name": "nuxt-shop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "deploy": "nuxt build && wrangler deploy",
    "preview": "wrangler dev",
    "cf:typegen": "wrangler types",
    "postinstall": "nuxt prepare",
    "lint:markup": "markuplint \"app/**/*.vue\"",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "daisyui": "^5.7.50",
    "idb": "^8.0.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@baptistecrouzet/nuxt-oxlint": "^1.1.5",
    "@markuplint/pug-parser": "^5.2.0",
    "@markuplint/vue-parser": "^5.2.0",
    "@markuplint/vue-spec": "^5.2.0",
    "@pinia/nuxt": "^1.0.3",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "h3": "^1.15.11",
    "knip": "^6.41.0",
    "markuplint": "^5.2.0",
    "nuxt": "4.6.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pinia": "^4.1.0",
    "pug": "^3.0.4",
    "typescript": "^5.9.3",
    "vite-plugin-remove-console": "^2.2.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@12.6.0"
}
