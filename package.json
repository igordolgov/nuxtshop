{
  "name": "nuxt-shop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "deploy": "nuxt build && wrangler deploy && node scripts/deploy-copy-in-ci.mjs",
    "preview": "wrangler dev",
    "cf:typegen": "wrangler types",
    "postinstall": "nuxt prepare",
    "lint:markup": "markuplint \"app/**/*.vue\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .nuxt/tsconfig.server.json && tsc --noEmit -p .nuxt/tsconfig.shared.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/image": "^2.2.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@sentry/nuxt": "^11.13.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vite-pwa/nuxt": "^2.0.1",
    "@vueuse/core": "^15.0.0",
    "daisyui": "^5.8.1",
    "h3": "^1.15.11",
    "idb": "^8.0.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@baptistecrouzet/nuxt-oxlint": "^1.1.5",
    "@markuplint/pug-parser": "^5.6.1",
    "@markuplint/vue-parser": "^5.6.1",
    "@markuplint/vue-spec": "^5.6.1",
    "@nuxt/cli": "^4.0.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "knip": "^6.45.1",
    "markuplint": "^5.6.1",
    "nuxt": "4.6.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "pug": "^3.0.4",
    "typescript": "7.0.2",
    "vite-plugin-remove-console": "^2.2.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "wrangler": "^4.164.0"
  },
  "packageManager": "pnpm@12.6.0"
}
